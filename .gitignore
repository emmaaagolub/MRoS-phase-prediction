# ------------------------------------------------------------
# R
.Rproj.user
.Rhistory
.RData
.Ruserdata

# ------------------------------------------------------------
# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.env
venv/

# ------------------------------------------------------------
# Large data files — ALL locations
# (keeps repo to code + small CSVs only)

/Data/

# Raster / gridded
*.tif
*.tiff
*.nc
*.nc4
*.hdf
*.hdf5
*.bil
*.bil.aux.xml
*.prj

# Tabular / serialized
*.parquet
*.arrow
*.feather
*.csv.gz

# Compressed archives (downloaded zips from PRISM, USGS, etc.)
*.zip

# ------------------------------------------------------------
# Exceptions — small CSVs that ARE tracked
# (station metadata, error logs, config look-up tables)
!Data/Stations/station_metadata*.csv
!Data/Stations/*_error_log.csv

# ------------------------------------------------------------
# Specific output directories
# (belt-and-suspenders in case extension rules above miss something)
outputs/hourly_pipeline/
outputs/resampled_grids/
Data/
ML_pipeline/model_artifacts/

