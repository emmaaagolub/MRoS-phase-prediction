# Only the pipeline code and its documentation are tracked.
# Data live on Zenodo (see data/README.md); results are produced locally.
/data/*
!/data/README.md
/results/
/legacy/
/manuscript/
/Manuscript/
/archive/
/zenodo_upload/
/outputs/

# ------------------------------------------------------------
# R
.Rproj.user
.Rhistory
.RData
.Ruserdata

# ------------------------------------------------------------
# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.env
venv/
.venv/

# ------------------------------------------------------------
# Safety net: never commit large data files from anywhere
*.nc
*.nc4
*.tif
*.tiff
*.parquet
*.zip
*.pkl
*.bin

# ------------------------------------------------------------
# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json
