\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Held-out test-set point estimates with 95\% cluster-bootstrap confidence intervals (5{,}000 resamples; 30-km $\times $ calendar-day clusters; percentile intervals). $\Delta $ rows are differences against the best benchmark in each domain ($T_d = \ensuremath  {0.0\,^{\circ }\mathrm  {C}}$ in CA; $T_d = \ensuremath  {0.5\,^{\circ }\mathrm  {C}}$ in CO). Phase bias is the percentage by which each phase was predicted more ($+$) or less ($-$) often than observed. All intervals are conditional on the trained model and realized split.}}{10}{}\protected@file@percent }
\newlabel{tab:bootstrap}{{3}{10}{}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-phase F1, flag rate (a.k.a., abstain rate), and mix-capture rate in \ensuremath  {1\,^{\circ }\mathrm  {C}} wet-bulb bins for California (top) and Colorado (bottom), validation (dashed) and test (solid). Shading marks $|T_w| \le \ensuremath  {2\,^{\circ }\mathrm  {C}}$; bins span \ensuremath  {-6\,^{\circ }\mathrm  {C}} to \ensuremath  {6\,^{\circ }\mathrm  {C}} and are plotted at midpoints. The F1 panels count only observations the model committed to. Line breaks mark undefined or under-sampled statistics, arising where a bin's committed sample holds one phase or fewer than 10 observations.}}{10}{}\protected@file@percent }
\newlabel{fig:twet}{{3}{10}{}{figure.3}{}}
